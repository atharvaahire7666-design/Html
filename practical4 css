 <!DOCTYPE html>
<html>
<head>
    <title>CSS Example</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">

    <!-- Internal CSS -->
    <style>
        h2 {
            color: green;
        }

        table, th, td {
            border: 1px solid black;
        }
    </style>
</head>

<body>

    <!-- Inline CSS -->
    <h1 style="color: blue;">Student Table</h1>

    <h2>Class Details</h2>

    <table>
        <tr>
            <th>Name</th>
            <th>Marks</th>
        </tr>

        <tr>
            <td>Atharva</td>
            <td style="color:red;">90</td>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>85</td>
        </tr>
    </table>

</body>
</html>